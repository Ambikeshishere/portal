# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project → Settings → Environment Variables.

# Turso (libSQL) database
DB_URL=libsql://your-db-your-org.aws-ap-south-1.turso.io
DB_AUTH_TOKEN=

# Google Apps Script mail service
MAIL_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
MAIL_KEY=

# Shared secret for /api/cron/* endpoints (must match ref-script-2/Config.js)
CRON_SECRET=

# Public portal URL (used to build approval links)
PORTAL_BASE_URL=http://localhost:3000

# Firebase (Google sign-in) — your Firebase project id, e.g. pw-portal-xxxxx
# Find it in Firebase console → Project settings → General → Project ID.
FIREBASE_PROJECT_ID=
